# Copy this file to .env.local and fill in the values (never commit .env.local).
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Supabase project (Supabase -> Project Settings -> API). Read on the server only.
# Never put the service_role / secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public address of the app, no trailing slash (used in password-reset emails).
# Office PC: http://192.168.1.50:3000   Vercel: https://your-app.vercel.app
SITE_URL=

# Google AI Studio key for the AI reader (import and pasted price text).
GEMINI_API_KEY=
