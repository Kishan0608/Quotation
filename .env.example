# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API (Data API / API Keys).
#
# These are read on the server only and are never sent to the browser.

SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key.
# NEVER put the service_role / secret key here - the app does not need it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public URL of the app (used in password-reset emails). No trailing slash.
SITE_URL=http://localhost:3000
